    "/mesh/v1/tasks/{task_id}/events": {
      "get": {
        "summary": "Task Events",
        "operationId": "task_events_mesh_v1_tasks__task_id__events_get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Task Events Mesh V1 Tasks  Task Id  Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mesh/v1/tasks/{task_id}/attachments/{name}": {
      "put": {
        "summary": "Put Attachment",
        "operationId": "put_attachment_mesh_v1_tasks__task_id__attachments__name__put",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
